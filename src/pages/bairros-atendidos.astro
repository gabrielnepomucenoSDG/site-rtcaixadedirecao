---
import Base from '../layouts/Base.astro';
import { WA_LINKS, MAPS_ROUTE_GOOGLE, ADDRESS_FULL } from '../lib/constants';

const bairrosPrincipais = [
  {
    name: "Olho d'Água",
    desc: "Sede da RT Caixa de Direção. A oficina fica na Av. Mahiba Azar — referência central do bairro.",
    destaque: true,
  },
  {
    name: "Turu",
    desc: "Bairro vizinho ao Olho d'Água, com acesso direto pela via de ligação. Menos de 5 minutos.",
    destaque: false,
  },
  {
    name: "Parque Vitória",
    desc: "Próximo ao eixo Olho d'Água, com boa ligação pelas vias locais.",
    destaque: false,
  },
  {
    name: "Calhau",
    desc: "Saindo do Calhau, a RT é a alternativa mais próxima ao invés de ir até o São Cristóvão.",
    destaque: false,
  },
  {
    name: "Cohama",
    desc: "A Cohama fica mais perto do Olho d'Água do que de boa parte das alternativas na cidade.",
    destaque: false,
  },
  {
    name: "Araçagi",
    desc: "Bairro adjacente com acesso facilitado pela rota Olho d'Água.",
    destaque: false,
  },
  {
    name: "Divineia",
    desc: "Acesso conveniente pelo eixo da região noroeste de São Luís.",
    destaque: false,
  },
  {
    name: "Vila Luizão",
    desc: "Bairro próximo que se beneficia da localização da RT como a referência mais acessível.",
    destaque: false,
  },
];
---

<Base
  title="Caixa de Direção em Turu, Calhau, Cohama e Região | RT – São Luís"
  description="Especialista em caixa de direção no Olho d'Água, São Luís. Referência mais próxima para quem mora no Turu, Parque Vitória, Calhau, Cohama, Araçagi, Divineia, Vila Luizão e adjacências."
  canonical="https://rtcaixadedirecao.com.br/bairros-atendidos"
>
  <main>

    <!-- Hero -->
    <section class="bairros-hero section">
      <div class="container">
        <nav class="breadcrumb" aria-label="Localização na página">
          <a href="/">Início</a>
          <span aria-hidden="true">›</span>
          <span aria-current="page">Bairros atendidos</span>
        </nav>

        <span class="badge badge--accent" style="margin-bottom: 1rem; display: inline-block;">Localização</span>
        <h1>Especialista em caixa de direção perto de você</h1>
        <p class="bairros-hero__sub">
          A RT Caixa de Direção fica no Olho d'Água, em São Luís — uma localização estratégica para quem mora ou trabalha na parte noroeste da cidade. Sem precisar atravessar São Luís para encontrar um serviço especializado.
        </p>

        <div class="bairros-hero__cta">
          <a href={MAPS_ROUTE_GOOGLE} class="btn btn--primary btn--lg" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            Como chegar
          </a>
          <a href={WA_LINKS.hero} class="btn btn--outline btn--lg" target="_blank" rel="noopener noreferrer">
            Falar no WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Bairros -->
    <section class="bairros-list section section--alt" aria-label="Lista de bairros">
      <div class="container">
        <div class="section-header">
          <h2>Bairros com acesso à RT Caixa de Direção</h2>
          <p>Veja os bairros que têm a RT como a opção especializada mais próxima na cidade.</p>
        </div>

        <div class="bairros-grid" role="list">
          {bairrosPrincipais.map((b) => (
            <div class={`bairros-card card${b.destaque ? ' bairros-card--destaque' : ''}`} role="listitem">
              {b.destaque && (
                <span class="badge badge--accent" style="align-self: flex-start; margin-bottom: 0.5rem;">Nossa sede</span>
              )}
              <h3>{b.name}</h3>
              <p>{b.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Por que importa a localização -->
    <section class="bairros-why section">
      <div class="container">
        <div class="bairros-why__inner">
          <div class="section-header" style="margin-bottom: 0;">
            <span class="badge badge--accent">Por que faz diferença</span>
            <h2>A localização no Olho d'Água não é por acaso</h2>
            <p style="max-width: 60ch;">
              A maior concentração de oficinas especializadas em caixa de direção de São Luís fica em outra região da cidade. Para quem mora ou trabalha no Olho d'Água, Turu, Calhau ou Cohama, isso significa tempo no trânsito, combustível e logística para um carro que está com problema de direção.
            </p>
            <p style="max-width: 60ch; margin-top: 0.75rem;">
              A RT foi montada para ser a referência desse lado da cidade. Você leva o carro, deixa e busca — sem precisar atravessar São Luís.
            </p>
          </div>

          <div class="bairros-why__cards">
            <div class="bairros-why__card">
              <strong>Prazo médio de 1 dia útil</strong>
              <span>Na maioria dos casos, o carro entra de manhã e sai no mesmo dia.</span>
            </div>
            <div class="bairros-why__card">
              <strong>Sem esperar encomenda</strong>
              <span>Modelos populares em estoque com pronta entrega.</span>
            </div>
            <div class="bairros-why__card">
              <strong>Peça sai testada</strong>
              <span>Pressurização na bancada antes de reinstalar no carro.</span>
            </div>
          </div>

          <a
            href={WA_LINKS.hero}
            class="btn btn--primary btn--lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            Falar com a oficina
          </a>
        </div>
      </div>
    </section>

    <!-- Endereço em texto puro (SEO) -->
    <section class="bairros-endereco section section--alt">
      <div class="container" style="max-width: 640px;">
        <h2>Endereço completo</h2>
        <address style="font-style: normal; font-size: 1rem; color: var(--text-muted); line-height: 1.8; margin-top: 0.75rem;">
          {ADDRESS_FULL}
        </address>
        <p style="font-size: 0.875rem; color: var(--text-subtle); margin-top: 0.5rem;">
          Referência: Olho d'Água, São Luís – MA
        </p>
      </div>
    </section>

    <!-- Nav de volta -->
    <div class="container" style="padding-block: 1.5rem; border-top: 1px solid var(--border);">
      <a href="/" style="font-size: 0.875rem; color: var(--accent);">← Voltar para a página principal</a>
    </div>

  </main>
</Base>

<style>
  .bairros-hero {
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--accent); }
  .breadcrumb a:hover { text-decoration: underline; }

  .bairros-hero h1 {
    margin-block: 0.5rem 1rem;
  }

  .bairros-hero__sub {
    font-size: 1.0625rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
    max-width: 56ch;
    line-height: 1.7;
  }

  .bairros-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  /* Grid de bairros */
  .bairros-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    .bairros-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .bairros-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .bairros-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    transition: border-color 0.2s;
  }

  .bairros-card--destaque {
    border-color: rgba(56, 182, 255, 0.4);
    background-color: rgba(56, 182, 255, 0.08);
  }

  .bairros-card h3 {
    font-size: 1.1rem;
    color: var(--text);
  }

  .bairros-card p {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  /* Por que a localização */
  .bairros-why__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 760px;
  }

  .bairros-why__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }

  @media (min-width: 600px) {
    .bairros-why__cards { grid-template-columns: repeat(3, 1fr); }
  }

  .bairros-why__card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .bairros-why__card strong {
    font-size: 0.9375rem;
    color: var(--text);
    font-weight: 600;
  }

  .bairros-why__card span {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
