---
import { WA_LINKS } from '../lib/constants';
---

<section class="b2b section" id="para-mecanicos" aria-labelledby="b2b-title">
  <div class="container">
    <div class="b2b__inner">

      <!-- Badge de segmento -->
      <div class="b2b__tag">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Para mecânicos e oficinas
      </div>

      <div class="b2b__content-grid">
        <div class="b2b__text">
          <h2 id="b2b-title">Você é mecânico ou tem uma oficina?</h2>
          <p>
            A maioria das oficinas não tem especialização em caixa de direção — e está tudo certo. Terceirizar esse serviço para a gente é uma forma de entregar um resultado melhor para o seu cliente sem precisar investir em equipamento ou treinamento específico.
          </p>
          <p>
            Trabalhamos com mecânicos e oficinas de São Luís que precisam de um serviço confiável, com prazo curto e resultado garantido. O carro do seu cliente fica aqui o tempo necessário, sai testado e com garantia por escrito de 6 meses.
          </p>
          <a
            href={WA_LINKS.b2b}
            class="btn btn--primary btn--lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.089.536 4.05 1.472 5.763L.057 23.05a.75.75 0 0 0 .916.928l5.42-1.393A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.863 0-3.607-.5-5.113-1.371l-.364-.214-3.77.97.998-3.68-.233-.376A9.96 9.96 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
            </svg>
            Falar sobre parceria
          </a>
        </div>

        <div class="b2b__cards">
          <div class="b2b__card">
            <div class="b2b__card-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <strong>Prazo médio: 1 dia útil</strong>
              <span>Seu cliente não fica parado por muito tempo</span>
            </div>
          </div>

          <div class="b2b__card">
            <div class="b2b__card-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>
              </svg>
            </div>
            <div>
              <strong>Garantia de 6 meses</strong>
              <span>Você passa a garantia para o seu cliente com tranquilidade</span>
            </div>
          </div>

          <div class="b2b__card">
            <div class="b2b__card-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2v-4M9 21H5a2 2 0 0 1-2-2v-4m0 0h18"/>
              </svg>
            </div>
            <div>
              <strong>Peça sai testada</strong>
              <span>Máquina hidráulica na bancada + scanner avançado</span>
            </div>
          </div>

          <div class="b2b__card">
            <div class="b2b__card-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
              </svg>
            </div>
            <div>
              <strong>Estoque de peças</strong>
              <span>Modelos populares com pronta entrega</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .b2b {
    background: linear-gradient(135deg, #0f0e09 0%, #1a1500 60%, #0D0D0D 100%);
    border-top: 1px solid rgba(232,160,0,0.15);
    border-bottom: 1px solid rgba(232,160,0,0.15);
  }

  .b2b__inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .b2b__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(232,160,0,0.08);
    border: 1px solid rgba(232,160,0,0.25);
    color: var(--accent);
    padding: 0.4rem 1rem;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    align-self: flex-start;
  }

  .b2b__content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .b2b__content-grid {
      grid-template-columns: 1fr 340px;
      gap: 4rem;
      align-items: start;
    }
  }

  .b2b__text {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .b2b__text h2 {
    font-size: clamp(2rem, 5vw, 2.75rem);
  }

  .b2b__text p {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 55ch;
  }

  .b2b__cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .b2b__card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background-color: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.125rem 1.25rem;
    transition: border-color 0.2s;
  }

  .b2b__card:hover { border-color: rgba(232,160,0,0.3); }

  .b2b__card-icon {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    background-color: var(--accent-dim);
    color: var(--accent);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .b2b__card > div:last-child {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .b2b__card strong {
    font-size: 0.9375rem;
    color: var(--text);
    font-weight: 600;
  }

  .b2b__card span {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.45;
  }
</style>
