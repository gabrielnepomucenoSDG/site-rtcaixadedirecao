---
import {
  PHONE_DISPLAY, WA_NUMBER, INSTAGRAM_URL, INSTAGRAM,
  ADDRESS_STREET, ADDRESS_DISTRICT, ADDRESS_CITY, ADDRESS_ZIP,
  HOURS_WEEKDAY, HOURS_SATURDAY, WA_LINKS,
} from '../lib/constants';

const bairros = [
  'Olho d\'Água', 'Turu', 'Parque Vitória', 'Calhau',
  'Cohama', 'Araçagi', 'Divineia', 'Vila Luizão',
];
---

<!-- Fechamento / CTA final -->
<section class="fechamento section" aria-label="Chamada para ação final">
  <div class="container">
    <div class="fechamento__inner">
      <h2>Pronto para resolver o problema da sua direção?</h2>
      <p>A gente tira dúvidas e passa orçamento pelo WhatsApp, sem compromisso.</p>
      <a
        href={WA_LINKS.hero}
        class="btn btn--primary btn--lg"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.089.536 4.05 1.472 5.763L.057 23.05a.75.75 0 0 0 .916.928l5.42-1.393A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.863 0-3.607-.5-5.113-1.371l-.364-.214-3.77.97.998-3.68-.233-.376A9.96 9.96 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
        </svg>
        Falar no WhatsApp
      </a>
    </div>
  </div>
</section>

<!-- Rodapé -->
<footer class="rodape" role="contentinfo" aria-label="Rodapé">
  <div class="container">
    <div class="rodape__grid">

      <!-- Coluna 1: Marca -->
      <div class="rodape__col rodape__col--brand">
        <div class="rodape__logo">
          <span class="rodape__logo-mark" aria-hidden="true">RT</span>
          <div>
            <strong>RT Caixa de Direção</strong>
            <span>Especialista em São Luís – MA</span>
          </div>
        </div>
        <p class="rodape__tagline">
          Reforma, manutenção e venda de caixas de direção hidráulicas, mecânicas e elétricas. Com teste hidráulico, scanner avançado e garantia por escrito.
        </p>
        <!-- Social -->
        <div class="rodape__social">
          <a
            href={INSTAGRAM_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram da RT Caixa de Direção"
            class="rodape__social-link"
          >
            <!-- Instagram icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
            </svg>
            @{INSTAGRAM}
          </a>
          <a
            href={WA_LINKS.fab}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp da RT Caixa de Direção"
            class="rodape__social-link"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.089.536 4.05 1.472 5.763L.057 23.05a.75.75 0 0 0 .916.928l5.42-1.393A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.863 0-3.607-.5-5.113-1.371l-.364-.214-3.77.97.998-3.68-.233-.376A9.96 9.96 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
            </svg>
            {PHONE_DISPLAY}
          </a>
        </div>
      </div>

      <!-- Coluna 2: Contato e horários -->
      <div class="rodape__col">
        <h3 class="rodape__col-title">Contato & Localização</h3>
        <address class="rodape__address">
          <p>{ADDRESS_STREET}</p>
          <p>{ADDRESS_DISTRICT} – {ADDRESS_CITY}</p>
          <p>CEP {ADDRESS_ZIP}</p>
        </address>
        <div class="rodape__hours">
          <p>{HOURS_WEEKDAY}</p>
          <p>{HOURS_SATURDAY}</p>
        </div>
        <a href={`tel:+${WA_NUMBER}`} class="rodape__phone">{PHONE_DISPLAY}</a>
      </div>

      <!-- Coluna 3: Bairros -->
      <div class="rodape__col">
        <h3 class="rodape__col-title">Bairros atendidos</h3>
        <ul class="rodape__bairros" role="list">
          {bairros.map((b) => <li>{b}</li>)}
        </ul>
        <a href="/bairros-atendidos" class="btn btn--ghost" style="font-size:0.8125rem; margin-top:0.5rem;">
          Ver todos →
        </a>
      </div>

    </div>

    <div class="rodape__bottom">
      <p>© {new Date().getFullYear()} RT Caixa de Direção — São Luís, MA.</p>
      <p class="rodape__made">
        Todos os direitos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  /* ——— Fechamento ——— */
  .fechamento {
    background: linear-gradient(135deg, #111000 0%, #1a1400 50%, #0D0D0D 100%);
    border-top: 1px solid rgba(232,160,0,0.2);
    text-align: center;
  }

  .fechamento__inner {
    max-width: 600px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.125rem;
  }

  .fechamento__inner h2 {
    font-size: clamp(1.75rem, 5vw, 2.75rem);
  }

  .fechamento__inner p {
    color: var(--text-muted);
    font-size: 1rem;
    text-align: center;
  }

  /* ——— Rodapé ——— */
  .rodape {
    background-color: #080808;
    border-top: 1px solid var(--border);
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: 1.5rem;
  }

  .rodape__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  @media (min-width: 640px) {
    .rodape__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .rodape__grid { grid-template-columns: 2fr 1fr 1fr; }
  }

  .rodape__col-title {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-subtle);
    margin-bottom: 1rem;
  }

  /* Brand column */
  .rodape__col--brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rodape__logo {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .rodape__logo-mark {
    width: 46px;
    height: 46px;
    background-color: var(--accent);
    color: #0D0D0D;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Barlow Condensed', system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.125rem;
    flex-shrink: 0;
  }

  .rodape__logo > div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .rodape__logo strong {
    font-size: 0.9375rem;
    color: var(--text);
  }

  .rodape__logo span {
    font-size: 0.75rem;
    color: var(--text-subtle);
  }

  .rodape__tagline {
    font-size: 0.8125rem;
    color: var(--text-subtle);
    line-height: 1.65;
    max-width: 38ch;
  }

  .rodape__social {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .rodape__social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    transition: color 0.15s;
  }

  .rodape__social-link:hover { color: var(--accent); }

  /* Contact column */
  .rodape__col {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .rodape__address {
    font-style: normal;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.65;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .rodape__hours {
    font-size: 0.875rem;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .rodape__phone {
    font-size: 0.9375rem;
    color: var(--text);
    font-weight: 600;
    transition: color 0.15s;
  }
  .rodape__phone:hover { color: var(--accent); }

  /* Bairros column */
  .rodape__bairros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .rodape__bairros li {
    font-size: 0.8125rem;
    color: var(--text-muted);
    background-color: var(--surface-2);
    border: 1px solid var(--border);
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
  }

  /* Bottom bar */
  .rodape__bottom {
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-subtle);
  }
</style>
