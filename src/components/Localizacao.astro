---
import {
  ADDRESS_STREET, ADDRESS_DISTRICT, ADDRESS_CITY, ADDRESS_ZIP,
  HOURS_WEEKDAY, HOURS_SATURDAY, MAPS_ROUTE_GOOGLE, MAPS_ROUTE_APPLE,
  MAPS_EMBED_URL,
} from '../lib/constants';

const bairros = [
  'Olho d\'Água', 'Turu', 'Parque Vitória', 'Calhau',
  'Cohama', 'Araçagi', 'Divineia', 'Vila Luizão',
];
---

<section class="localizacao section section--alt" id="localizacao">
  <div class="container">
    <div class="section-header">
      <span class="badge badge--accent">Onde ficamos</span>
      <h2>Mais perto de você</h2>
      <p>
        Estamos no Olho d'Água, São Luís — a referência de caixa de direção
        para quem mora ou trabalha nessa parte da cidade.
      </p>
    </div>

    <div class="localizacao__grid">

      <!-- Mapa -->
      <div class="localizacao__map-wrap">
        <iframe
          src={MAPS_EMBED_URL}
          width="100%"
          height="100%"
          style="border:0; min-height: 320px;"
          allowfullscreen={false}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Localização RT Caixa de Direção — Av. Mahiba Azar, Olho d'Água, São Luís"
        ></iframe>
      </div>

      <!-- Detalhes -->
      <div class="localizacao__details">

        <!-- Endereço -->
        <div class="localizacao__block">
          <div class="localizacao__block-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div>
            <strong class="localizacao__label">Endereço</strong>
            <address class="localizacao__value" itemscope itemtype="https://schema.org/PostalAddress">
              <span itemprop="streetAddress">{ADDRESS_STREET}</span><br/>
              <span itemprop="addressLocality">{ADDRESS_DISTRICT} – {ADDRESS_CITY}</span><br/>
              <span itemprop="postalCode">CEP {ADDRESS_ZIP}</span>
            </address>
          </div>
        </div>

        <!-- Horários -->
        <div class="localizacao__block">
          <div class="localizacao__block-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div>
            <strong class="localizacao__label">Horário de funcionamento</strong>
            <p class="localizacao__value">{HOURS_WEEKDAY}</p>
            <p class="localizacao__value">{HOURS_SATURDAY}</p>
          </div>
        </div>

        <!-- Botões de rota -->
        <div class="localizacao__routes">
          <a
            href={MAPS_ROUTE_GOOGLE}
            class="btn btn--primary"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Traçar rota no Google Maps"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            Google Maps
          </a>
          <a
            href={MAPS_ROUTE_APPLE}
            class="btn btn--outline"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Traçar rota no Apple Maps"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            Apple Maps
          </a>
        </div>

        <!-- Bairros atendidos -->
        <div class="localizacao__bairros">
          <strong class="localizacao__label">Referência para a região</strong>
          <p class="localizacao__bairros-intro">
            Fica no caminho de quem mora ou trabalha no:
          </p>
          <ul class="localizacao__bairros-list" role="list">
            {bairros.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
          <a href="/bairros-atendidos" class="btn btn--ghost" style="font-size:0.875rem; margin-top:0.25rem;">
            Ver todos os bairros →
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .localizacao__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .localizacao__grid {
      grid-template-columns: 1fr 380px;
      gap: 2.5rem;
    }
  }

  .localizacao__map-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    min-height: 340px;
    background-color: var(--surface-2);
  }

  .localizacao__map-wrap iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 340px;
  }

  .localizacao__details {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .localizacao__block {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .localizacao__block-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--radius);
    background-color: var(--accent-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    margin-top: 0.125rem;
  }

  .localizacao__label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-subtle);
    font-weight: 700;
    margin-bottom: 0.3rem;
  }

  .localizacao__value {
    font-size: 0.9375rem;
    color: var(--text);
    font-style: normal;
    line-height: 1.6;
  }

  .localizacao__routes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .localizacao__bairros {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .localizacao__bairros-intro {
    font-size: 0.875rem;
    color: var(--text-muted);
    max-width: none;
  }

  .localizacao__bairros-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.5rem;
    margin-top: 0.25rem;
  }

  .localizacao__bairros-list li {
    font-size: 0.8125rem;
    color: var(--text);
    background-color: var(--surface-2);
    border: 1px solid var(--border);
    padding: 0.25rem 0.625rem;
    border-radius: 100px;
  }
</style>
