---
// Faixa de selos de confiança / diferenciais técnicos
---

<section class="selos section section--alt" aria-label="Nossos diferenciais">
  <div class="container">
    <ul class="selos__list" role="list">

      <!-- Selo 1: Teste hidráulico -->
      <li class="selos__item">
        <div class="selos__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2v-4M9 21H5a2 2 0 0 1-2-2v-4m0 0h18"/>
          </svg>
        </div>
        <div class="selos__text">
          <strong>Teste Hidráulico na Bancada</strong>
          <span>Cada caixa é pressurizada antes de voltar ao carro</span>
        </div>
      </li>

      <li class="selos__divider" aria-hidden="true"></li>

      <!-- Selo 2: Scanner + programação -->
      <li class="selos__item">
        <div class="selos__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
        </div>
        <div class="selos__text">
          <strong>Scanner + Programação Elétrica</strong>
          <span>Diagnóstico eletrônico avançado e programação de módulos</span>
        </div>
      </li>

      <li class="selos__divider" aria-hidden="true"></li>

      <!-- Selo 3: Pronta entrega -->
      <li class="selos__item">
        <div class="selos__icon selos__icon--green" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
        </div>
        <div class="selos__text">
          <strong>Pronta Entrega</strong>
          <span>Caixas recondicionadas originais em estoque</span>
        </div>
      </li>

      <li class="selos__divider" aria-hidden="true"></li>

      <!-- Selo 4: Garantia -->
      <li class="selos__item">
        <div class="selos__icon selos__icon--green" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>
          </svg>
        </div>
        <div class="selos__text">
          <strong>Garantia por Escrito</strong>
          <span>6 meses de garantia documentada no serviço</span>
        </div>
      </li>

    </ul>
  </div>
</section>

<style>
  .selos {
    padding-block: 1.5rem;
  }

  .selos__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0;
    align-items: stretch;
    /* Em mobile, empilha e usa scroll horizontal */
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* Resetar para grid no desktop */
  }
  .selos__list::-webkit-scrollbar { display: none; }

  /* Mobile: linha horizontal scrollável */
  @media (max-width: 767px) {
    .selos__list {
      display: flex;
      flex-wrap: nowrap;
      gap: 0;
      padding-bottom: 0.25rem;
    }
    .selos__item {
      flex: 0 0 260px;
    }
  }

  .selos__item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
  }

  .selos__divider {
    width: 1px;
    background-color: var(--border);
    align-self: stretch;
    flex-shrink: 0;
  }

  @media (max-width: 767px) {
    .selos__divider { display: none; }
  }

  .selos__icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    background-color: var(--accent-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
  }

  .selos__icon--green {
    background-color: var(--green-dim);
    color: var(--green);
  }

  .selos__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .selos__text strong {
    font-size: 0.9375rem;
    color: var(--text);
    font-weight: 600;
    line-height: 1.3;
  }

  .selos__text span {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.4;
  }
</style>
