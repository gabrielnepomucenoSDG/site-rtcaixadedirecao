---
import { WA_LINKS } from '../lib/constants';
---

<a
  href={WA_LINKS.fab}
  class="wa-fab"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar no WhatsApp"
>
  <!-- WhatsApp icon -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    width="28"
    height="28"
  >
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
    <path d="M12 0C5.373 0 0 5.373 0 12c0 2.089.536 4.05 1.472 5.763L.057 23.05a.75.75 0 0 0 .916.928l5.42-1.393A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.863 0-3.607-.5-5.113-1.371l-.364-.214-3.77.97.998-3.68-.233-.376A9.96 9.96 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
  </svg>

  <span class="wa-fab__label">WhatsApp</span>
  <span class="wa-fab__pulse" aria-hidden="true"></span>
</a>

<style>
  .wa-fab {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 1000;

    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.25rem 0.875rem 1rem;

    background-color: #25D366;
    color: #fff;
    border-radius: 100px;
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.4);

    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1;
    text-decoration: none;

    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .wa-fab:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 6px 28px rgba(37, 211, 102, 0.55);
  }

  .wa-fab:active { transform: scale(0.97); }

  /* Em telas muito pequenas, esconde o rótulo */
  @media (max-width: 360px) {
    .wa-fab {
      padding: 0.875rem;
    }
    .wa-fab__label { display: none; }
  }

  /* Anel pulsante de atenção */
  .wa-fab__pulse {
    position: absolute;
    inset: 0;
    border-radius: 100px;
    border: 2px solid #25D366;
    animation: wa-pulse 2s ease-out infinite;
    pointer-events: none;
  }

  @keyframes wa-pulse {
    0%   { opacity: 1; transform: scale(1); }
    70%  { opacity: 0; transform: scale(1.3); }
    100% { opacity: 0; transform: scale(1.3); }
  }
</style>
