---
import { WA_LINKS, PHONE_DISPLAY } from '../lib/constants';
---

<header class="header">
  <div class="container header__inner">
    <!-- Logo & Nome da Marca -->
    <a href="/" class="header__brand" aria-label="RT Caixa de Direção - Página Inicial">
      <img
        src="/images/logo-transparent.png"
        alt="Logo RT Caixa de Direção"
        class="header__logo-img"
        width="46"
        height="46"
        loading="eager"
      />
      <div class="header__brand-text">
        <span class="header__brand-name">RT Caixa de Direção</span>
        <span class="header__brand-sub">Mecânica • Hidráulica • Elétrica</span>
      </div>
    </a>

    <!-- Navegação Desktop -->
    <nav class="header__nav" aria-label="Navegação principal">
      <ul class="header__nav-list">
        <li><a href="/#servicos" class="header__nav-link">Serviços</a></li>
        <li><a href="/#sintomas" class="header__nav-link">Sintomas</a></li>
        <li><a href="/#por-que-testada" class="header__nav-link">Diferenciais</a></li>
        <li><a href="/#localizacao" class="header__nav-link">Onde Estamos</a></li>
        <li><a href="/bairros-atendidos" class="header__nav-link">Bairros</a></li>
      </ul>
    </nav>

    <!-- Ação Rápida WhatsApp -->
    <div class="header__actions">
      <a
        href={WA_LINKS.hero}
        class="btn btn--primary header__cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.089.536 4.05 1.472 5.763L.057 23.05a.75.75 0 0 0 .916.928l5.42-1.393A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.863 0-3.607-.5-5.113-1.371l-.364-.214-3.77.97.998-3.68-.233-.376A9.96 9.96 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
        </svg>
        <span class="header__cta-text">WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 900;
    background-color: rgba(8, 10, 13, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 1.5rem;
  }

  /* Marca */
  .header__brand {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__logo-img {
    width: 46px;
    height: 46px;
    object-fit: contain;
    border-radius: 8px;
    filter: drop-shadow(0 2px 8px rgba(56, 182, 255, 0.25));
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .header__brand:hover .header__logo-img {
    transform: scale(1.05);
    filter: drop-shadow(0 3px 12px rgba(56, 182, 255, 0.45));
  }

  .header__brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .header__brand-name {
    font-family: 'Barlow Condensed', system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.25rem;
    line-height: 1.1;
    color: var(--text);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .header__brand-sub {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Navegação */
  .header__nav {
    display: none;
  }

  @media (min-width: 900px) {
    .header__nav {
      display: block;
    }
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .header__nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.15s ease;
    position: relative;
    padding-block: 0.25rem;
  }

  .header__nav-link:hover {
    color: var(--accent);
  }

  /* CTA */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header__cta {
    padding: 0.625rem 1.125rem;
    font-size: 0.875rem;
    border-radius: 100px;
  }

  @media (max-width: 480px) {
    .header__brand-sub {
      display: none;
    }
    .header__brand-name {
      font-size: 1.05rem;
    }
    .header__logo-img {
      width: 40px;
      height: 40px;
    }
    .header__cta-text {
      display: none;
    }
    .header__cta {
      padding: 0.625rem;
    }
  }
</style>
