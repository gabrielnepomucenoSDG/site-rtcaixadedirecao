---
import { WA_LINKS, MAPS_ROUTE_GOOGLE, HOURS_WEEKDAY, HOURS_SATURDAY } from '../lib/constants';
---

<section class="hero" aria-label="Apresentação">
  <div class="hero__bg-glow" aria-hidden="true"></div>

  <div class="container hero__inner">
    <!-- Conteúdo textual -->
    <div class="hero__content">
      <span class="badge badge--accent hero__badge">Especialista em Caixa de Direção</span>

      <h1 class="hero__title">
        Direção pesada ou<br />
        barulho ao virar?
      </h1>

      <p class="hero__subtitle">
        A oficina especialista em caixa de direção fica aqui no
        <strong>Olho d'Água</strong> — mais perto de você.
        Reforma em até <strong>1 dia útil</strong>,
        com garantia por escrito de <strong>6 meses</strong>.
      </p>

      <div class="hero__cta-group">
        <a
          href={WA_LINKS.hero}
          class="btn btn--primary btn--lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          <!-- WhatsApp icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.089.536 4.05 1.472 5.763L.057 23.05a.75.75 0 0 0 .916.928l5.42-1.393A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.863 0-3.607-.5-5.113-1.371l-.364-.214-3.77.97.998-3.68-.233-.376A9.96 9.96 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
          </svg>
          Falar no WhatsApp
        </a>

        <a
          href={MAPS_ROUTE_GOOGLE}
          class="btn btn--outline btn--lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          <!-- Map pin icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          Como chegar
        </a>
      </div>
    </div>

    <!-- Visual / placeholder de foto -->
    <div class="hero__visual" aria-hidden="true">
      <div class="hero__photo-placeholder">
        <div class="hero__photo-inner">
          <!-- Ícone de chave inglesa decorativo -->
          <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
          </svg>
          <span>[FOTO: Bancada ou fachada da oficina]</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra de informações rápidas -->
  <div class="hero__infobar">
    <div class="container hero__infobar-inner">
      <span class="hero__info-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        {HOURS_WEEKDAY}
      </span>
      <span class="hero__info-sep" aria-hidden="true">·</span>
      <span class="hero__info-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        {HOURS_SATURDAY}
      </span>
      <span class="hero__info-sep" aria-hidden="true">·</span>
      <span class="hero__info-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Olho d'Água, São Luís – MA
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--bg);
    overflow: hidden;
    /* Gradient de fundo para dar profundidade */
    background-image:
      radial-gradient(ellipse 80% 60% at 75% 40%, rgba(232,160,0,0.07) 0%, transparent 65%),
      radial-gradient(ellipse 60% 80% at 10% 80%, rgba(232,160,0,0.04) 0%, transparent 60%);
  }

  /* Glow decorativo */
  .hero__bg-glow {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(232,160,0,0.06) 0%, transparent 70%);
    pointer-events: none;
    border-radius: 50%;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-block: clamp(4rem, 10vw, 7rem);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr 420px;
      gap: 4rem;
    }
  }

  .hero__badge {
    margin-bottom: 1rem;
  }

  .hero__title {
    font-size: clamp(2.6rem, 7.5vw, 4.5rem);
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  .hero__title em {
    color: var(--accent);
    font-style: normal;
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.1875rem);
    color: var(--text-muted);
    margin-bottom: 2rem;
    max-width: 52ch;
    line-height: 1.7;
  }

  .hero__subtitle strong {
    color: var(--text);
  }

  .hero__cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    align-items: center;
  }

  /* Visual placeholder */
  .hero__visual {
    display: none;
  }

  @media (min-width: 900px) {
    .hero__visual {
      display: block;
    }
  }

  .hero__photo-placeholder {
    aspect-ratio: 4/3;
    background-color: var(--surface);
    border: 2px dashed var(--border);
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__photo-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
    color: var(--text-subtle);
    font-style: italic;
    font-size: 0.8125rem;
    text-align: center;
  }

  .hero__photo-inner svg {
    color: var(--text-subtle);
    opacity: 0.5;
  }

  /* Barra de informações */
  .hero__infobar {
    background-color: var(--surface);
    border-top: 1px solid var(--border);
    padding-block: 0.875rem;
    position: relative;
    z-index: 1;
  }

  .hero__infobar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .hero__info-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .hero__info-item svg {
    flex-shrink: 0;
    color: var(--accent);
  }

  .hero__info-sep {
    color: var(--border);
    font-size: 1rem;
  }

  @media (max-width: 540px) {
    .hero__info-sep { display: none; }
    .hero__infobar-inner { flex-direction: column; align-items: flex-start; gap: 0.375rem; }
  }
</style>
